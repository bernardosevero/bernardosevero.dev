# Optional PostHog analytics. The snippet loads only when both values are set,
# for example PUBLIC_POSTHOG_HOST=https://us.i.posthog.com.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=

# Astro deployment settings. Shell/CI variables override these values.
SITE_URL=https://bernardosevero.dev
BASE_PATH=/

# Cloudflare deployment credentials (never use a PUBLIC_ prefix).
# Create a token with Account > Cloudflare Pages > Edit permission.
# Also configure these as GitHub Actions secrets for automatic deployments.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
