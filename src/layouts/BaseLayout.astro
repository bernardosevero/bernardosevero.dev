---
import '@fontsource/pixelify-sans/latin-700.css';
import '@fontsource/vt323/latin-400.css';
import '../styles/tokens.css';
import '../styles/global.css';
import SiteNavigation from '../components/SiteNavigation.astro';
import PostHog from '../components/posthog.astro';

interface Props {
  title: string;
  description?: string;
  preloadVillage?: boolean;
  socialImage?: string;
  socialImageAlt?: string;
  navigation?: boolean;
}

const {
  title,
  description = "Bernardo Severo's personal portfolio with a medieval RPG theme.",
  preloadVillage = false,
  navigation = true,
  socialImage,
  socialImageAlt = 'Bernardo Severo, Software Engineer, on a parchment sign in a welcoming pixel-art medieval village.',
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL(socialImage ?? `${base}images/social-card-v2.jpg`, Astro.site);
const relativePath = Astro.url.pathname.startsWith(base)
  ? Astro.url.pathname.slice(base.length)
  : Astro.url.pathname.replace(/^\/+/, '');
const showSiteNavigation = navigation && !['', 'about', 'about/', 'system', 'system/'].includes(relativePath);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#315746" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="image_src" href={socialImageUrl} />
    <meta itemprop="image" content={socialImageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Bernardo Severo — Personal Log" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:url" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <PostHog />
    {preloadVillage && <link rel="preload" href={`${base}images/village.webp`} as="image" fetchpriority="high" />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {showSiteNavigation && <div class="base-navigation"><SiteNavigation pathname={Astro.url.pathname} /></div>}
    <slot />
  </body>
</html>

<style>
  .base-navigation {
    position: absolute;
    z-index: 1;
    top: clamp(18px, 3vw, 40px);
    left: 50%;
    width: min(1160px, calc(100% - 32px));
    transform: translateX(-50%);
  }

  .base-navigation + :global(.portfolio-page) { padding-top: 204px; }

  @media (max-width: 820px) {
    .base-navigation + :global(.portfolio-page) { padding-top: 240px; }
  }

  @media (max-width: 520px) {
    .base-navigation { width: min(100% - 16px, 1160px); }
  }
</style>
