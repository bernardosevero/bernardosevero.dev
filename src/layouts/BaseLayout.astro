---
import '@fontsource/pixelify-sans/latin-700.css';
import '@fontsource/vt323/latin-400.css';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  preloadVillage?: boolean;
}

const {
  title,
  description = "Bernardo Severo's personal portfolio with a medieval RPG theme.",
  preloadVillage = false,
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#315746" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    {preloadVillage && <link rel="preload" href={`${base}images/village.webp`} as="image" fetchpriority="high" />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
  </body>
</html>
