---
interface Props {
  rating?: number;
}
const { rating } = Astro.props;
---

<span class="book-rating">
  {rating === undefined ? (
    <span>Not rated</span>
  ) : (
    <>
      <span class="sr-only">{rating} out of 5 stars</span>
      <span class="book-rating__stars" aria-hidden="true">
        {Array.from({ length: 5 }, (_, index) => (
          <svg viewBox="0 0 32 32" class="book-rating__star">
            <path class="book-rating__outline" d="m16 2 4 8 9 2-6 7 1 10-8-5-8 5 1-10-6-7 9-2Z" />
            <path
              class="book-rating__fill"
              style={`clip-path: inset(0 ${100 - Math.max(0, Math.min(1, rating - index)) * 100}% 0 0)`}
              d="m16 2 4 8 9 2-6 7 1 10-8-5-8 5 1-10-6-7 9-2Z"
            />
          </svg>
        ))}
      </span>
    </>
  )}
</span>
<style>
  .book-rating {
    display: inline-flex;
    max-width: 100%;
    align-items: center;
    font-size: var(--text-md);
  }
  .book-rating__stars {
    display: flex;
    min-width: 0;
    gap: 4px;
  }
  /* Stars keep their size when there is room and shrink evenly in the narrowest panels. */
  .book-rating__star {
    width: 30px;
    height: auto;
    min-width: 0;
    aspect-ratio: 1;
    overflow: visible;
  }
  .book-rating__outline {
    fill: var(--parchment);
    stroke: var(--ink);
    stroke-width: 2;
  }
  .book-rating__fill {
    fill: var(--gold);
    stroke: var(--ink);
    stroke-width: 2;
  }
  @container (width <= 650px) {
    .book-rating__star {
      width: 26px;
    }
  }
</style>
