---
interface Props { class?: string; parchment?: boolean; }
const { class: className, parchment = true } = Astro.props;
---
<section class:list={['wood-frame', className, { 'wood-frame--parchment': parchment }]}>
  <div class="frame-surface"><slot /></div>
  <span class="iron-corner iron-corner--tl" aria-hidden="true"></span>
  <span class="iron-corner iron-corner--tr" aria-hidden="true"></span>
  <span class="iron-corner iron-corner--bl" aria-hidden="true"></span>
  <span class="iron-corner iron-corner--br" aria-hidden="true"></span>
</section>
