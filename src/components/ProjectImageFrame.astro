---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { ProjectImageSource } from '../utils/project-image';
import { getDestinationType } from '../utils/project-links';

interface Props {
  image: ImageMetadata;
  imageSource: ProjectImageSource;
  /** Main destination opened by the image; unverified hosts leave the image unlinked. */
  primaryUrl?: string | undefined;
  /** Responsive `sizes` for the slot the frame fills. */
  sizes: string;
}

const { image, imageSource, primaryUrl, sizes } = Astro.props;
const destinationType = primaryUrl ? getDestinationType(primaryUrl) : undefined;

// Decorative in both states: the linked image repeats a destination already listed as text.
const imageProps = {
  src: image,
  alt: '',
  widths: [304, 608],
  sizes,
  loading: 'lazy' as const,
};
---

<div class="project-image" data-image-source={imageSource}>
  {primaryUrl && destinationType ? (
    <a
      href={primaryUrl}
      tabindex="-1"
      aria-hidden="true"
      data-project-destination={destinationType}
      data-project-trigger="image"
    >
      <Image {...imageProps} />
    </a>
  ) : (
    <Image {...imageProps} />
  )}
</div>

<style>
  .project-image {
    position: relative;
    aspect-ratio: 1200 / 630;
    border: 3px solid var(--wood-dark);
    box-shadow:
      0 3px var(--wood-shadow),
      3px 0 var(--parchment-edge);
    overflow: hidden;
  }

  /* The inner highlight sits above the image, which would otherwise cover an inset shadow. */
  .project-image::after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 0 3px var(--parchment-light);
    pointer-events: none;
  }

  /* The image link duplicates a listed link, so it is hidden from keyboard and assistive tech. */
  .project-image a {
    display: block;
    height: 100%;
    cursor: pointer;
  }

  .project-image:has(a:hover) {
    border-color: var(--gold);
  }

  .project-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
