---
import { basePath as base } from '../utils/paths';
import WoodFrame from './WoodFrame.astro';
import { getActiveNavigationItem, navigationItems } from '../config/navigation';
import { Image } from 'astro:assets';
import wizardPortrait from '../assets/bernardo-wizard.png';

interface Props {
  pathname: string;
  preview?: boolean;
}

const { pathname, preview = false } = Astro.props;
const Item = preview ? 'span' : 'a';
const Container = preview ? 'div' : 'nav';

const activeItem = getActiveNavigationItem(pathname, base);
const homeActive = activeItem === 'home';
---

<WoodFrame parchment={false} class="site-navigation">
  <Container class="site-navigation__list" aria-label={preview ? undefined : 'Main navigation'}>
    <Item
      class="site-navigation__home"
      href={preview ? undefined : base}
      aria-label={preview ? undefined : 'Home'}
      title={preview ? undefined : 'Home'}
      aria-current={homeActive ? 'page' : undefined}
    >
      <Image src={wizardPortrait} alt="" width={48} densities={[1, 2]} format="webp" />
    </Item>
    {navigationItems.map((item) => {
      const active = item.id === activeItem;
      return (
        <Item
          class="rpg-button site-navigation__link"
          data-active={active ? 'true' : 'false'}
          href={preview ? undefined : `${base}${item.path}`}
          aria-current={active ? 'page' : undefined}
        >
          <span class="site-navigation__gem" aria-hidden="true"></span>
          {item.label}
        </Item>
      );
    })}
  </Container>
</WoodFrame>

<style>
  :global(.site-navigation) {
    width: 100%;
    margin: 0;
    container-type: inline-size;
  }
  :global(.site-navigation .frame-surface) {
    padding: 12px;
    border: 2px solid #2a190f;
    background: #5b3422;
  }
  .site-navigation__list {
    display: grid;
    grid-template-columns: 54px repeat(5, minmax(0, 1fr));
    gap: 10px;
  }
  .site-navigation__home {
    display: grid;
    place-items: center;
    box-sizing: border-box;
    width: 54px;
    height: 54px;
    align-self: center;
    border: 3px solid var(--ornament);
    background: var(--green-shade);
    box-shadow: 0 3px var(--button-shadow);
  }
  .site-navigation__home img {
    display: block;
    width: 48px;
    height: 48px;
    image-rendering: pixelated;
  }
  a.site-navigation__home:hover,
  .site-navigation__home[aria-current='page'] {
    border-color: var(--gold);
  }
  .site-navigation__link {
    min-height: 54px;
    padding: 8px 10px;
    font-size: clamp(var(--text-xs), 2.2vw, var(--text-lg));
    text-decoration: none;
  }
  .site-navigation__link[data-active='true'] {
    border-color: #754815;
    background: linear-gradient(#71c17f, #49a76b);
    color: #182b20;
    text-shadow: 1px 1px #9de19d;
  }
  .site-navigation__gem {
    position: absolute;
    width: 18px;
    height: 18px;
    left: -14px;
    top: calc(50% - 9px);
    transform: rotate(45deg);
    border: 2px solid #8b5515;
    background: #ffc84b;
    box-shadow:
      inset 2px 2px var(--gold-highlight),
      inset -2px -2px #d89220,
      0 0 0 2px #4b2e11;
    opacity: 0;
  }
  .site-navigation__link[data-active='true'] .site-navigation__gem {
    opacity: 1;
  }

  @container (width <= 760px) {
    /* An even 3×2 grid: the tile widens to a full cell with the portrait centered. */
    .site-navigation__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .site-navigation__home {
      width: 100%;
    }
  }

  /* Below 314px (a 376px viewport), a third of the menu cannot fit PROJECTS at
     --text-xs, so the same cells form an even 2×3 grid instead. */
  @container (width < 314px) {
    .site-navigation__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width <= 520px) {
    :global(.site-navigation .frame-surface) {
      padding: 8px;
    }
    /* Narrow padding gives PROJECTS room in a third of the menu near the 314px switch. */
    .site-navigation__link {
      padding-inline: 4px;
    }
    .site-navigation__gem {
      left: -10px;
    }
  }
</style>
