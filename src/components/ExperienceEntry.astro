---
import type { ImageMetadata } from 'astro';
import CompanyTile from './CompanyTile.astro';

interface Props {
  company: string;
  role: string;
  period: string;
  description: string;
  logo?: ImageMetadata | undefined;
}

const { company, role, period, description, logo } = Astro.props;
---

<li>
  <div class="timeline-heading">
    <CompanyTile company={company} logo={logo} />
    <div class="timeline-heading-text">
      <h3>{company}</h3>
      <p class="timeline-role">{role}</p>
      <p class="timeline-period">{period}</p>
    </div>
  </div>
  <p>{description}</p>
</li>
