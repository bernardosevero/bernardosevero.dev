---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { companyMonogram } from '../utils/format';

interface Props {
  company: string;
  role: string;
  period: string;
  description: string;
  logo?: ImageMetadata | undefined;
}

const { company, role, period, description, logo } = Astro.props;
---

<li>
  <div class="timeline-heading">
    <span class="company-tile">
      {logo ? (
        <Image src={logo} alt="" width={28} height={28} />
      ) : (
        <span aria-hidden="true">{companyMonogram(company)}</span>
      )}
    </span>
    <div class="timeline-heading-text">
      <h3>{company}</h3>
      <p class="timeline-role">{role}</p>
      <p class="timeline-period">{period}</p>
    </div>
  </div>
  <p>{description}</p>
</li>
