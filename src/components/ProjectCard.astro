---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { ProjectImageSource } from '../utils/project-image';

interface Props {
  title: string;
  summary: string;
  image: ImageMetadata;
  imageSource: ProjectImageSource;
  links?: Array<{ label: string; url: string }>;
  /** Main destination opened by the image: the live app, otherwise the first listed link. */
  primaryUrl?: string;
}

const { title, summary, image, imageSource, links = [], primaryUrl } = Astro.props;

// Verified public hosts and the analytics destination type each one reports.
const destinationTypes = new Map([
  ['github.com', 'source_repository'],
  ['www.alura.com.br', 'published_formation'],
  ['dsa-learning.bernardosevero.dev', 'live_application'],
]);

function getDestinationType(value: string): string | undefined {
  const url = URL.parse(value);
  if (url?.protocol !== 'https:') return undefined;
  return destinationTypes.get(url.hostname);
}

const verifiedLinks = links.flatMap((link) => {
  const destinationType = getDestinationType(link.url);
  return destinationType ? [{ ...link, destinationType }] : [];
});

// Decorative in both states: the linked image repeats a destination already listed as text.
const imageProps = {
  src: image,
  alt: '',
  widths: [304, 608],
  sizes: '(max-width: 800px) 100vw, 304px',
  loading: 'lazy' as const,
};

const primaryDestinationType = primaryUrl ? getDestinationType(primaryUrl) : undefined;
---

<article class="project-card">
  <div class="project-card__layout">
    <div class="project-card__image" data-image-source={imageSource}>
      {primaryUrl && primaryDestinationType ? (
        <a
          href={primaryUrl}
          tabindex="-1"
          aria-hidden="true"
          data-project-destination={primaryDestinationType}
          data-project-trigger="image"
        >
          <Image {...imageProps} />
        </a>
      ) : (
        <Image {...imageProps} />
      )}
    </div>
    <div class="project-card__body">
      <h2>{title}</h2>
      <p>{summary}</p>
      {verifiedLinks.length > 0 && (
        <ul class="project-card__links" aria-label={`${title} links`}>
          {verifiedLinks.map((link) => (
            <li>
              <a
                href={link.url}
                data-project-destination={link.destinationType}
                data-project-trigger="link"
              >
                {link.label} <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</article>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-project-destination]').forEach((link) => {
    link.addEventListener('click', () => {
      window.posthog?.capture('project_destination_opened', {
        destination_type: link.dataset.projectDestination,
        trigger: link.dataset.projectTrigger,
      });
    });
  });
</script>

<style>
  .project-card {
    position: relative;
    display: block;
    min-height: 100%;
    container-type: inline-size;
    padding: 22px;
    border: 3px solid var(--parchment-edge);
    background: #f9e5b188;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .project-card h2 {
    font-family: var(--font-text);
    font-size: clamp(var(--text-lg), 4vw, var(--text-2xl));
    font-weight: 700;
    line-height: 1.15;
  }

  .project-card__layout {
    display: grid;
    gap: 18px;
  }

  .project-card__image {
    position: relative;
    aspect-ratio: 1200 / 630;
    border: 3px solid var(--wood-dark);
    box-shadow:
      0 3px var(--wood-shadow),
      3px 0 var(--parchment-edge);
    overflow: hidden;
  }

  /* The inner highlight sits above the image, which would otherwise cover an inset shadow. */
  .project-card__image::after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 0 3px var(--parchment-light);
    pointer-events: none;
  }

  /* The image link duplicates a listed link, so it is hidden from keyboard and assistive tech. */
  .project-card__image a {
    display: block;
    height: 100%;
    cursor: pointer;
  }

  .project-card__image:has(a:hover) {
    border-color: var(--gold);
  }

  .project-card__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-card p {
    max-width: 70ch;
    margin-top: 12px;
    font-family: var(--font-text);
    font-size: clamp(var(--text-xs), 2vw, var(--text-sm));
    line-height: 1.55;
  }

  .project-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .project-card__links a {
    color: var(--green-dark);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
  }

  .project-card__links a:hover {
    color: var(--green);
  }
  .project-card__links a:focus-visible {
    outline: 4px solid var(--gold);
    outline-offset: 4px;
  }

  /* Side by side only when the text column keeps a readable width, including in /system/ cells. */
  @container (width > 600px) {
    .project-card__layout {
      grid-template-columns: 304px minmax(0, 1fr);
      gap: 28px;
      align-items: start;
    }

    .project-card h2 {
      font-size: clamp(var(--text-lg), 3.2vw, var(--text-xl));
    }
  }

  @media (width <= 520px) {
    .project-card__links {
      display: grid;
    }
  }
</style>
