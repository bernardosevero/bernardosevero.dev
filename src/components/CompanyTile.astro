---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { companyMonogram } from '../utils/format';

interface Props {
  company: string;
  logo?: ImageMetadata | undefined;
}

// Decorative in both forms: the company name always sits beside the tile.
const { company, logo } = Astro.props;
---

<span class="company-tile">
  {logo ? (
    <Image src={logo} alt="" width={28} height={28} />
  ) : (
    <span aria-hidden="true">{companyMonogram(company)}</span>
  )}
</span>

<style>
  .company-tile {
    display: grid;
    flex: none;
    box-sizing: border-box;
    width: 40px;
    height: 40px;
    place-items: center;
    border: 2px solid var(--wood-dark);
    background: var(--parchment-light);
    box-shadow:
      inset 0 0 0 2px var(--parchment),
      0 2px var(--wood-shadow);
    color: var(--ink-soft);
    font-family: var(--font-heading);
    font-size: var(--text-2xs);
    font-weight: 700;
    line-height: 1;
  }

  .company-tile img {
    width: 28px;
    height: 28px;
    object-fit: contain;
  }
</style>
