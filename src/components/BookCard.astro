---
interface Props { title: string; author: string; status: string; coverSrc?: string; rating?: number; reviewHref?: string; }
const { title, author, status, coverSrc, rating, reviewHref } = Astro.props;
---
<article class="book-card">
  <div class="book-card__cover">
    {coverSrc && <img src={coverSrc} alt={`Cover of ${title}`} width="360" height="540" loading="lazy" />}
    <span class="book-card__fallback" aria-hidden={coverSrc ? 'true' : undefined}>Cover unavailable</span>
  </div>
  <div class="book-card__content"><p class="book-card__status">{status}</p><h3>{reviewHref ? <a href={reviewHref}>{title}</a> : title}</h3><p>{author}</p>{rating !== undefined && <p class="status-badge">Rating: {rating} / 5</p>}{reviewHref && <a class="book-card__review" href={reviewHref}>Read review →</a>}</div>
</article>
<style>
  .book-card{display:grid;grid-template-columns:92px minmax(0,1fr);gap:12px;min-height:154px;padding:12px;border:3px solid var(--parchment-edge);background:#f9e5b188}.book-card__cover{position:relative;display:grid;aspect-ratio:2/3;place-items:center;overflow:hidden;background:#6f4b32;color:var(--parchment-light);text-align:center}.book-card__cover img{width:100%;height:100%;object-fit:cover}.book-card__fallback{padding:6px;font:16px/1 var(--font-heading);text-transform:uppercase}.book-card__content{min-width:0}.book-card__status{color:var(--ink-soft);font-family:var(--font-heading);font-size:15px;text-transform:uppercase}h3{font-size:23px;text-transform:uppercase}h3 a{color:inherit}.status-badge{display:inline-block;margin-top:10px}.book-card__review{display:block;margin-top:10px;color:var(--green-dark);font-family:var(--font-heading);font-size:18px;text-transform:uppercase}
</style>
