---
import { isVisibleContent } from '../../utils/content';
import PortfolioPage from '../../layouts/PortfolioPage.astro';
import WoodFrame from '../../components/WoodFrame.astro';
import Ornament from '../../components/Ornament.astro';
import { getCollection, render } from 'astro:content';
import '../../styles/portfolio.css';
export async function getStaticPaths() {
  const projects = await getCollection('projects', isVisibleContent);

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<PortfolioPage title={`${project.data.title} — Bernardo Severo`} description={project.data.summary}>
  <WoodFrame class="portfolio-frame case-study">
    <header>
      <p class="page-kicker">Case Study</p>
      <h1 class="page-title">{project.data.title}</h1>
      <p class="page-intro">{project.data.summary}</p>
      <Ornament variant="divider" />
    </header>
    <dl class="case-facts">
      <div>
        <dt>Role</dt>
        <dd>{project.data.role}</dd>
      </div>
      <div>
        <dt>Technologies</dt>
        <dd>
          <ul class="tag-list">
            {project.data.technologies.map((technology) => (
              <li>{technology}</li>
            ))}
          </ul>
        </dd>
      </div>
    </dl>
    <div class="case-grid">
      <section>
        <h2 class="page-heading">Problem</h2>
        <p>{project.data.problem}</p>
        <h2 class="page-heading">Contribution</h2>
        <p>{project.data.contribution}</p>
      </section>
      <section>
        <h2 class="page-heading">Decisions</h2>
        <ul>
          {project.data.decisions.map((decision) => (
            <li>{decision}</li>
          ))}
        </ul>
        <h2 class="page-heading">Outcomes</h2>
        <ul>
          {project.data.outcomes.map((outcome) => (
            <li>{outcome}</li>
          ))}
        </ul>
      </section>
    </div>
    <section>
      <h2 class="page-heading">Constraints</h2>
      <ul>
        {project.data.constraints.map((constraint) => (
          <li>{constraint}</li>
        ))}
      </ul>
      <h2 class="page-heading">Lessons</h2>
      <ul>
        {project.data.lessons.map((lesson) => (
          <li>{lesson}</li>
        ))}
      </ul>
    </section>
    <section class="case-note">
      <Content />
    </section>
  </WoodFrame>
</PortfolioPage>
<style>
  .case-facts {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 18px;
    padding: 18px 0;
    border-block: 3px solid var(--ornament);
  }

  .case-facts dt,
  .case-study h2 {
    font-family: var(--font-heading);
    text-transform: uppercase;
  }

  .case-facts dd {
    margin: 7px 0 0;
  }

  .case-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 42px;
    margin: 28px 0;
  }

  .case-study h2 {
    margin: 20px 0 7px;
    font-size: 1.75rem;
  }

  .case-study li {
    margin-block: 7px;
  }

  .case-note {
    margin-top: 26px;
    padding-top: 18px;
    border-top: 2px solid var(--parchment-edge);
    color: var(--ink-soft);
  }

  @media (width <= 640px) {
    .case-facts,
    .case-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }
</style>
