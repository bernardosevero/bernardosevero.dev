---
import BaseLayout from '../layouts/BaseLayout.astro';
import WoodFrame from '../components/WoodFrame.astro';
import Ornament from '../components/Ornament.astro';
import { getEntry, render } from 'astro:content';
import '../styles/portfolio.css';

const about = await getEntry('pages', 'about');
if (!about || about.data.kind !== 'about') throw new Error('The About content entry is missing or invalid.');
const { Content } = await render(about);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title="About — Bernardo Severo" description="Experience, specialties, tools, and contact paths for Bernardo Severo." preloadVillage>
  <main id="main-content" class="portfolio-page" style={`--portfolio-village: url('${base}images/village.webp')`} tabindex="-1">
    <div class="portfolio-shell">
      <a class="back-link" href={base}>← Personal Log</a>
      <WoodFrame class="portfolio-frame about-frame">
        <header>
          <p class="page-kicker">Character Sheet</p>
          <h1 class="page-title">About</h1>
          <Ornament variant="divider" />
        </header>
        <div class="about-grid">
          <section class="profile-card" aria-labelledby="identity-heading">
            <div class="monogram" aria-hidden="true">B</div>
            <h2 id="identity-heading">{about.data.name}</h2>
            <p class="profile-role">{about.data.title}</p>
            <dl class="identity-list">
              <div><dt>Base</dt><dd>{about.data.base}</dd></div>
              <div><dt>Focus</dt><dd>{about.data.focus.join(' · ')}</dd></div>
            </dl>
            <p>{about.data.description}</p>
          </section>
          <section aria-labelledby="experience-heading">
            <h2 id="experience-heading" class="page-heading">Experience</h2>
            <ol class="timeline">
              {about.data.experience.map((item) => <li><p class="timeline-company">{item.company}</p><p class="timeline-role">{item.role}</p><p class="meta">{item.period}</p><p>{item.description}</p></li>)}
            </ol>
          </section>
        </div>
        <div class="about-details">
          <section aria-labelledby="specializations-heading">
            <h2 id="specializations-heading" class="page-heading">Specializations</h2>
            <ul class="tag-list">{about.data.specializations.map((item) => <li>{item}</li>)}</ul>
          </section>
          <section aria-labelledby="tools-heading">
            <h2 id="tools-heading" class="page-heading">Tools</h2>
            <ul class="tag-list">{about.data.tools.map((item) => <li>{item}</li>)}</ul>
          </section>
        </div>
        <section class="about-copy" aria-labelledby="about-me-heading">
          <h2 id="about-me-heading" class="page-heading">About me</h2>
          <Content />
          <p class="tagline">{about.data.tagline}</p>
        </section>
        <footer class="contact-links" aria-label="Professional profiles">
          {about.data.links.map(({ label, url }) => <a class="rpg-button" href={url} target="_blank" rel="noreferrer">{label}<span class="sr-only"> (opens in a new tab)</span></a>)}
        </footer>
      </WoodFrame>
    </div>
  </main>
</BaseLayout>

<style>
  .about-grid { display: grid; grid-template-columns: minmax(250px, .8fr) minmax(0, 1.2fr); gap: clamp(28px, 5vw, 60px); }
  .profile-card { text-align: center; }
  .monogram { display: grid; width: 132px; aspect-ratio: 1; place-items: center; margin: 0 auto 16px; border: 9px double var(--gold); border-radius: 50%; background: radial-gradient(circle, #578a65, var(--green-dark)); box-shadow: 0 0 0 5px var(--wood-dark); color: var(--gold); font: 700 82px/1 var(--font-heading); text-shadow: 3px 3px var(--wood-dark); }
  .profile-card h2 { font-size: 35px; }
  .profile-role { color: var(--ink-soft); font-family: var(--font-heading); font-size: 21px; text-transform: uppercase; }
  .identity-list { margin: 22px 0; text-align: left; }
  .identity-list div { display: grid; grid-template-columns: 88px 1fr; padding: 7px 0; border-bottom: 2px solid #b5824266; }
  .identity-list dt { font-family: var(--font-heading); font-size: 18px; text-transform: uppercase; }.identity-list dd { margin: 0; }
  .timeline { margin: 12px 0 0; padding: 0 0 0 28px; border-left: 3px solid var(--ornament); list-style: none; }
  .timeline li { position: relative; padding: 0 0 22px 20px; }.timeline li::before { content: ''; position: absolute; left: -37px; top: 7px; width: 13px; aspect-ratio: 1; border: 3px solid var(--wood-dark); border-radius: 50%; background: var(--gold); }
  .timeline-company, .timeline-role { font-family: var(--font-heading); text-transform: uppercase; }.timeline-company { font-size: 25px; }.timeline-role { color: var(--ink-soft); font-size: 19px; }
  .about-details { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 20px; padding-top: 24px; border-top: 3px solid var(--ornament); }.about-details .page-heading { margin-bottom: 10px; font-size: 27px; }
  .about-copy { margin-top: 26px; padding-top: 22px; border-top: 3px solid var(--ornament); }.about-copy .page-heading { margin-bottom: 12px; }.about-copy :global(p + p) { margin-top: 10px; }.tagline { margin-top: 16px; color: var(--ink-soft); font-family: Georgia, serif; font-size: 22px; font-style: italic; text-align: right; }
  .contact-links { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 28px; }.contact-links .rpg-button { flex: 1 1 220px; text-decoration: none; }
  @media (max-width: 720px) { .about-grid, .about-details { grid-template-columns: 1fr; }.profile-card { max-width: 520px; margin-inline: auto; }.timeline { margin-left: 12px; } }
</style>
