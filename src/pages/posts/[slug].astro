---
import { isVisibleContent } from '../../utils/content';
import { formatCalendarDate } from '../../utils/format';
import PortfolioPage from '../../layouts/PortfolioPage.astro';
import WoodFrame from '../../components/WoodFrame.astro';
import Ornament from '../../components/Ornament.astro';
import ChapterBar from '../../components/ChapterBar.astro';
import { outlineSections } from '../../utils/outline';
import { getCollection, render } from 'astro:content';
import '../../styles/portfolio.css';

export async function getStaticPaths() {
  const posts = await getCollection('posts', isVisibleContent);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const sections = outlineSections(post.body ?? '', headings);
---

<PortfolioPage
  title={`${post.data.title} — Bernardo Severo`}
  description={post.data.description}
  shellTag="article"
>
  <WoodFrame class="portfolio-frame article">
    <header>
      <p class="page-kicker">{post.data.readingMinutes} min read</p>
      <h1 class="page-title">{post.data.title}</h1>
      <p class="page-intro">{post.data.description}</p>
      <p class="meta article-date">Published {formatCalendarDate(post.data.publishedAt, 'long')}</p>
      <Ornament variant="divider" />
    </header>
    <ul class="tag-list">
      {post.data.topics.map((topic) => (
        <li>{topic}</li>
      ))}
    </ul>
    <div class="article-reading">
      <ChapterBar sections={sections} readingMinutes={post.data.readingMinutes} />
      <div class="article-content prose">
        <Content />
      </div>
    </div>
  </WoodFrame>
</PortfolioPage>
<style>
  .article-date {
    text-align: center;
  }

  /* Bounds the sticky chapter bar to the article body. */
  .article-reading {
    margin-block-start: 28px;
  }

  .article-reading > :global(.chapter-bar) {
    margin-block-end: 20px;
  }

  /* Headings reached from Contents land below the sticky strip. chapter-bar.ts measures
     the strip; the fallback covers the shorter no-JavaScript strip. */
  .article-content :global(h2) {
    scroll-margin-top: calc(var(--chapter-bar-offset, 64px) + 16px);
  }
</style>
