---
import { isVisibleContent } from '../../utils/content';
import PortfolioPage from '../../layouts/PortfolioPage.astro';
import WoodFrame from '../../components/WoodFrame.astro';
import Ornament from '../../components/Ornament.astro';
import { getCollection, render } from 'astro:content';
import '../../styles/portfolio.css';

export async function getStaticPaths() {
  const posts = await getCollection('posts', isVisibleContent);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<PortfolioPage
  title={`${post.data.title} — Bernardo Severo`}
  description={post.data.description}
  shellTag="article"
>
  <WoodFrame class="portfolio-frame article">
    <header>
      <p class="page-kicker">{post.data.readingMinutes} min read</p>
      <h1 class="page-title">{post.data.title}</h1>
      <p class="page-intro">{post.data.description}</p>
      <p class="meta article-date">
        Published{' '}
        {post.data.publishedAt.toLocaleDateString('en-US', {
          month: 'long',
          day: 'numeric',
          year: 'numeric',
        })}
      </p>
      <Ornament variant="divider" />
    </header>
    <ul class="tag-list">
      {post.data.topics.map((topic) => (
        <li>{topic}</li>
      ))}
    </ul>
    <div class="article-content">
      <Content />
    </div>
  </WoodFrame>
</PortfolioPage>
<style>
  .article-date {
    text-align: center;
  }

  .article-content {
    margin: 28px auto 0;
    overflow-wrap: anywhere;
    font-size: clamp(var(--text-lg), 3vw, var(--text-xl));
    line-height: 1.25;
  }

  .article-content :global(h2) {
    margin: 32px 0 16px;
    font-size: var(--text-xl);
    text-align: center;
  }

  .article-content :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin-inline: auto;
  }

  .article-content :global(blockquote) {
    font-style: italic;
  }

  .article-content :global(p + p),
  .article-content :global(ul + p) {
    margin-top: 16px;
  }

  .article-content :global(a) {
    color: var(--green-dark);
  }
</style>
