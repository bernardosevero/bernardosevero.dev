---
import BaseLayout from '../layouts/BaseLayout.astro'; import WoodFrame from '../components/WoodFrame.astro'; import Ornament from '../components/Ornament.astro'; import { getCollection } from 'astro:content'; import '../styles/portfolio.css';
const showDraftPreviews = import.meta.env.DEV; const books = (await getCollection('books', ({ data }) => !data.draft || (showDraftPreviews && data.preview))).sort((a, b) => a.data.title.localeCompare(b.data.title)); const bookCards = books.map((book) => ({ book, hasReview: Boolean(book.body?.trim()) })); const sections = ['reading', 'finished', 'wishlist'] as const; const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<BaseLayout title="Reading — Bernardo Severo" description="A small reading codex maintained by Bernardo Severo." preloadVillage><main id="main-content" class="portfolio-page" style={`--portfolio-village: url('${base}images/village.webp')`} tabindex="-1"><div class="portfolio-shell"><a class="back-link" href={base}>← Personal Log</a><WoodFrame class="portfolio-frame"><header><p class="page-kicker">Reading Codex</p><h1 class="page-title">Reading</h1><p class="page-intro">Books collected here only when their status and rating can be represented honestly.</p><Ornament variant="divider" /></header>{books.length ? <div class="shelves">{sections.map((status) => <section id={status}><h2 class="page-heading">{status}</h2><div class="book-grid">{bookCards.filter(({ book }) => book.data.status === status).map(({ book, hasReview }) => hasReview ? <a class="book-card book-card-link" href={`${base}reading/${book.id}/`} aria-label={`Read review: ${book.data.title}`}><article><h3>{book.data.title}</h3><p>{book.data.author}</p>{book.data.preview && <p class="status-badge">Draft preview</p>}{book.data.rating !== undefined && <p class="status-badge">Rating: {book.data.rating} / 5</p>}<span class="review-link-label">Read review →</span></article></a> : <article class="book-card"><h3>{book.data.title}</h3><p>{book.data.author}</p>{book.data.preview && <p class="status-badge">Draft preview</p>}{book.data.rating !== undefined && <p class="status-badge">Rating: {book.data.rating} / 5</p>}</article>)}</div>{!books.some((book) => book.data.status === status) && <p class="shelf-empty">No books listed in this shelf yet.</p>}</section>)}</div> : <section class="empty-state"><h2 class="page-heading">The shelves are not catalogued yet</h2><p>No books are listed yet. Ratings will remain absent until they are personally supplied.</p></section>}</WoodFrame></div></main></BaseLayout>
<style>
  .shelves {
    display: grid;
    gap: 30px;
  }

  .shelves section + section {
    padding-top: 28px;
    border-top: 2px solid var(--ornament);
  }

  .book-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 16px;
    margin-top: 14px;
  }

  .book-card {
    display: block;
    min-height: 190px;
    padding: 18px;
    border: 3px solid var(--parchment-edge);
    background: #f9e5b188;
    color: inherit;
    text-decoration: none;
  }

  .book-card-link {
    transition: border-color 120ms ease, box-shadow 120ms ease, translate 120ms ease;
  }

  .book-card-link:hover {
    border-color: var(--gold);
    box-shadow: 0 5px 0 #6c4427;
    translate: 0 -2px;
  }

  .book-card h3 {
    font-family: var(--font-heading);
    font-size: 27px;
    text-transform: uppercase;
  }

  .book-card .status-badge {
    display: inline-block;
    margin-top: 14px;
  }

  .review-link-label {
    display: block;
    margin-top: 20px;
    color: var(--green-dark);
    font-family: var(--font-heading);
    font-size: 22px;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: reduce) {
    .book-card-link {
      transition: none;
    }
  }

  .shelf-empty {
    margin-top: 10px;
    color: var(--ink-soft);
  }
</style>
