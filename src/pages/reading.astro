---
import BaseLayout from '../layouts/BaseLayout.astro';
import WoodFrame from '../components/WoodFrame.astro';
import Ornament from '../components/Ornament.astro';
import BookCard from '../components/BookCard.astro';
import { getCollection } from 'astro:content';
import '../styles/portfolio.css';

const showDraftPreviews = import.meta.env.DEV;
const books = (await getCollection('books', ({ data }) => !data.draft || (showDraftPreviews && data.preview))).sort((a, b) => a.data.title.localeCompare(b.data.title));
const sections = ['reading', 'finished', 'wishlist'] as const;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title="Reading — Bernardo Severo" description="A small reading codex maintained by Bernardo Severo." preloadVillage>
  <main id="main-content" class="portfolio-page" style={`--portfolio-village: url('${base}images/village.webp')`} tabindex="-1">
    <div class="portfolio-shell">
      <a class="back-link" href={base}>← Personal Log</a>
      <WoodFrame class="portfolio-frame">
        <header><p class="page-kicker">Reading Codex</p><h1 class="page-title">Reading</h1><p class="page-intro">Books collected here only when their status and rating can be represented honestly.</p><Ornament variant="divider" /></header>
        <div class="shelves">{sections.map((status) => <section><h2 class="page-heading">{status}</h2><div class="book-grid">{books.filter((book) => book.data.status === status).map((book) => <BookCard title={book.data.title} author={book.data.author} status={book.data.status} coverSrc={book.data.coverAsset ? `${base}${book.data.coverAsset.slice(1)}` : book.data.coverUrl} rating={book.data.rating} reviewHref={book.body?.trim() ? `${base}reading/${book.id}/` : undefined} />)}</div>{!books.some((book) => book.data.status === status) && <p class="shelf-empty">No books listed in this shelf yet.</p>}</section>)}</div>
      </WoodFrame>
    </div>
  </main>
</BaseLayout>

<style>
  .shelves { display: grid; gap: 30px; }
  .shelves section + section { padding-top: 28px; border-top: 2px solid var(--ornament); }
  .book-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 16px; margin-top: 14px; }
  .shelf-empty { margin-top: 10px; color: var(--ink-soft); }
</style>
