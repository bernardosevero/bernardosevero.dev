---
import { isVisibleContent } from '../utils/content';
import { basePath as base } from '../utils/paths';
import PortfolioPage from '../layouts/PortfolioPage.astro';
import ReadingCodex from '../components/ReadingCodex.astro';
import { getCollection } from 'astro:content';
import '../styles/portfolio.css';

const books = (await getCollection('books', isVisibleContent)).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
const reviewIds = new Set(
  (await getCollection('bookReviews'))
    .filter((review) => review.body?.trim())
    .map((review) => review.id),
);

const codexBooks = books.map((book) => ({
  ...book.data,
  coverSrc: book.data.coverAsset ? `${base}${book.data.coverAsset.slice(1)}` : book.data.coverUrl,
  reviewHref: reviewIds.has(book.id) ? `${base}reading/${book.id}/` : undefined,
}));
---

<PortfolioPage
  title="Reading — Bernardo Severo"
  description="Explore Bernardo Severo's bookshelves, ratings, and reviews."
>
  <ReadingCodex books={codexBooks} />
</PortfolioPage>
