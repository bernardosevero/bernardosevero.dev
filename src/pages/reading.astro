---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReadingCodex from '../components/ReadingCodex.astro';
import SiteNavigation from '../components/SiteNavigation.astro';
import { getCollection } from 'astro:content';
import '../styles/portfolio.css';

const showDraftPreviews = import.meta.env.DEV;
const books = (await getCollection('books', ({ data }) => !data.draft || (showDraftPreviews && data.preview))).sort((a, b) => a.data.title.localeCompare(b.data.title));
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const codexBooks = books.map((book) => ({
  id: book.id,
  ...book.data,
  coverSrc: book.data.coverAsset ? `${base}${book.data.coverAsset.slice(1)}` : book.data.coverUrl,
  reviewHref: book.body?.trim() ? `${base}reading/${book.id}/` : undefined,
}));
---

<BaseLayout title="Reading — Bernardo Severo" description="Explore Bernardo Severo's bookshelves, ratings, and reviews." preloadVillage navigation={false}>
  <main id="main-content" class="portfolio-page reading-page" style={`--portfolio-village: url('${base}images/village.webp')`} tabindex="-1">
    <div class="reading-shell">
      <div class="reading-navigation">
        <SiteNavigation pathname={Astro.url.pathname} />
      </div>
      <a class="back-link" href={base}>← Personal Log</a>
      <ReadingCodex books={codexBooks} />
    </div>
  </main>
</BaseLayout>

<style>
  .reading-page { padding-block: 36px; }
  .reading-page::before { background: var(--portfolio-village) center / cover no-repeat, var(--green-dark); }
  .reading-page::after { opacity: .25; }
  .reading-shell { width: min(1050px, 100%); margin-inline: auto; }
  .reading-navigation { display: flow-root; margin-bottom: 12px; }
  @media (max-width: 650px) {
    .reading-page { padding-block: 16px; }
  }
</style>
