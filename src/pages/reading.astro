---
import { isVisibleContent } from '../utils/content';
import { basePath as base } from '../utils/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import ReadingCodex from '../components/ReadingCodex.astro';
import { getCollection } from 'astro:content';
import '../styles/portfolio.css';

const books = (await getCollection('books', isVisibleContent)).sort((a, b) => a.data.title.localeCompare(b.data.title));

const codexBooks = books.map((book) => ({
  id: book.id,
  ...book.data,
  coverSrc: book.data.coverAsset ? `${base}${book.data.coverAsset.slice(1)}` : book.data.coverUrl,
  reviewHref: book.body?.trim() ? `${base}reading/${book.id}/` : undefined,
}));
---

<BaseLayout title="Reading — Bernardo Severo" description="Explore Bernardo Severo's bookshelves, ratings, and reviews." preloadVillage>
  <main id="main-content" class="portfolio-page" style={`--portfolio-village: url('${base}images/village.webp')`} tabindex="-1">
    <div class="portfolio-shell">
      <ReadingCodex books={codexBooks} />
    </div>
  </main>
</BaseLayout>
