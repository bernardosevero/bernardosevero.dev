---
import { isVisibleContent } from '../../utils/content';
import { formatCalendarDate } from '../../utils/format';
import PortfolioPage from '../../layouts/PortfolioPage.astro';
import WoodFrame from '../../components/WoodFrame.astro';
import Ornament from '../../components/Ornament.astro';
import { getCollection, render } from 'astro:content';
import '../../styles/portfolio.css';

export async function getStaticPaths() {
  const [books, reviews] = await Promise.all([
    getCollection('books'),
    getCollection('bookReviews'),
  ]);
  const booksById = new Map(books.map((book) => [book.id, book]));

  return reviews.flatMap((review) => {
    const book = booksById.get(review.id);
    if (!book) throw new Error(`Book review has no catalog entry: ${review.id}`);
    if (!review.body?.trim() || !isVisibleContent(book)) return [];
    return [
      {
        params: { slug: review.id },
        props: { book, review },
      },
    ];
  });
}

const { book, review } = Astro.props;
const { Content } = await render(review);

const finishedAt = book.data.finishedAt
  ? formatCalendarDate(book.data.finishedAt, 'long')
  : undefined;
---

<PortfolioPage
  title={`${book.data.title} — Reading — Bernardo Severo`}
  description={`${book.data.title} by ${book.data.author}, read by Bernardo Severo.`}
  shellTag="article"
>
  <WoodFrame class="portfolio-frame review-frame">
    <header>
      <p class="page-kicker">Personal review</p>
      <h1 class="page-title">{book.data.title}</h1>
      <p class="page-intro">{book.data.author}</p>
      <div class="review-meta" aria-label="Book details">
        <span class="status-badge">{book.data.status}</span>
        {book.data.rating !== undefined && (
          <span class="status-badge">Rating: {book.data.rating} / 5</span>
        )}
        {finishedAt && <span class="status-badge">Finished {finishedAt}</span>}
      </div>
      <Ornament variant="divider" />
    </header>
    <div class="review-content">
      <Content />
    </div>
  </WoodFrame>
</PortfolioPage>

<style>
  .review-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 20px;
  }

  .review-content {
    max-width: 760px;
    margin: 30px auto 0;
    font-size: clamp(var(--text-md), 3vw, var(--text-xl));
    line-height: 1.3;
  }

  .review-content :global(p + p),
  .review-content :global(blockquote + p) {
    margin-top: 18px;
  }

  .review-content :global(blockquote) {
    margin: 24px 0;
    padding: 14px 18px;
    border-left: 5px solid var(--gold);
    background: #f9e5b177;
    color: var(--ink-soft);
  }
</style>
