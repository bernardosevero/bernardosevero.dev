---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WoodFrame from '../../components/WoodFrame.astro';
import Ornament from '../../components/Ornament.astro';
import { getCollection, render } from 'astro:content';
import '../../styles/portfolio.css';

export async function getStaticPaths() {
  const books = await getCollection(
    'books',
    ({ data }) => !data.draft || (import.meta.env.DEV && data.preview),
  );

  return books
    .filter((book) => book.body?.trim())
    .map((book) => ({
      params: { slug: book.id },
      props: { book },
    }));
}

const { book } = Astro.props;
const { Content } = await render(book);
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const finishedAt = book.data.finishedAt?.toLocaleDateString('en-US', {
  day: 'numeric',
  month: 'long',
  timeZone: 'UTC',
  year: 'numeric',
});
---
<BaseLayout
  title={`${book.data.title} — Reading — Bernardo Severo`}
  description={`${book.data.title} by ${book.data.author}, read by Bernardo Severo.`}
  preloadVillage
>
  <main
    id="main-content"
    class="portfolio-page"
    style={`--portfolio-village: url('${base}images/village.webp')`}
    tabindex="-1"
  >
    <article class="portfolio-shell">
      <a class="back-link" href={`${base}reading/`}>← Reading Codex</a>
      <WoodFrame class="portfolio-frame review-frame">
        <header>
          <p class="page-kicker">Personal review</p>
          <h1 class="page-title">{book.data.title}</h1>
          <p class="page-intro">{book.data.author}</p>
          <div class="review-meta" aria-label="Book details">
            <span class="status-badge">{book.data.status}</span>
            {book.data.rating !== undefined && <span class="status-badge">Rating: {book.data.rating} / 5</span>}
            {finishedAt && <span class="status-badge">Finished {finishedAt}</span>}
          </div>
          <Ornament variant="divider" />
        </header>
        <div class="review-content">
          <Content />
        </div>
      </WoodFrame>
    </article>
  </main>
</BaseLayout>

<style>
  .review-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 20px;
  }

  .review-content {
    max-width: 760px;
    margin: 30px auto 0;
    font-size: clamp(25px, 3vw, 30px);
    line-height: 1.3;
  }

  .review-content :global(p + p),
  .review-content :global(blockquote + p) {
    margin-top: 18px;
  }

  .review-content :global(blockquote) {
    margin: 24px 0;
    padding: 14px 18px;
    border-left: 5px solid var(--gold);
    background: #f9e5b177;
    color: var(--ink-soft);
  }
</style>
