---
import { basePath as base } from '../utils/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import Ornament from '../components/Ornament.astro';
import PixelIcon from '../components/PixelIcon.astro';
import CvDownloadLink from '../components/CvDownloadLink.astro';
import { cvAsset } from '../config/cv';
import WoodFrame from '../components/WoodFrame.astro';
import SiteNavigation from '../components/SiteNavigation.astro';
import BookTile from '../components/BookTile.astro';
import BookRating from '../components/BookRating.astro';
import ProjectCard from '../components/ProjectCard.astro';
import '../styles/portfolio.css';

const colorTokens = [
  '--ink', '--ink-soft', '--parchment', '--parchment-light', '--parchment-edge',
  '--wood-dark', '--wood', '--wood-light', '--green-dark', '--green', '--green-light',
  '--gold', '--ornament',
];
---

<BaseLayout
  title="Design System — Bernardo Severo"
  description="The live visual language and reusable interface primitives behind Bernardo Severo's RPG portfolio."
  preloadVillage
>
  <main id="main-content" class="portfolio-page system-page" style={`--portfolio-village: url('${base}images/village.webp')`} tabindex="-1">
    <WoodFrame parchment={false} class="system-frame">
      <header class="system-header system-surface">
        <Ornament variant="sprig" />
        <h1>Design System</h1>
        <Ornament variant="sprig" />
      </header>
      <div class="system-body">
    <section class="system-section system-surface">
      <h2>Color tokens</h2>
      <Ornament variant="divider" />
      <div class="swatch-grid">
        {colorTokens.map((token) => (
          <article class="swatch" data-token={token}>
            <span class="swatch-color" style={`--swatch: var(${token})`}></span>
            <code>{token}</code>
            <small data-token-value>Computed by the browser</small>
          </article>
        ))}
      </div>
    </section>

    <section class="system-section system-surface">
      <h2>Typography</h2>
      <Ornament variant="divider" />
      <div class="type-grid">
        <article><p class="type-heading">Quest headings</p><code>Pixelify Sans · 700</code></article>
        <article><p class="type-body">Readable notes, metadata, and longer stories.</p><code>VT323 · 400</code></article>
      </div>
    </section>

    <section class="system-section system-surface">
      <h2>Components and states</h2>
      <Ornament variant="divider" />
      <div class="component-grid">
        <article>
          <h3>Primary action</h3>
          <button class="rpg-button" type="button">Continue quest</button>
          <p>Hover, focus, active, and reduced-motion states belong to the same primitive.</p>
        </article>
        <article>
          <h3>Wood frame</h3>
          <WoodFrame class="wood-frame-specimen" parchment={false}>
            <p>Timber surround</p>
          </WoodFrame>
          <p>The same structural frame used for primary RPG windows.</p>
        </article>
        <article>
          <h3>Ornaments</h3>
          <div class="ornament-row"><Ornament variant="sprig" /><Ornament variant="divider" /></div>
          <p>Decorative shapes are hidden from assistive technology.</p>
        </article>
        <article>
          <h3>Pixel icons</h3>
          <div class="pixel-icon-row" aria-hidden="true"><PixelIcon name="vscode" /><PixelIcon name="docker" /><PixelIcon name="cloud" /></div>
          <div class="pixel-icon-row" aria-hidden="true"><PixelIcon name="briefcase" /><PixelIcon name="star" /><PixelIcon name="wrench" /><PixelIcon name="book" /></div>
          <p>Tool marks keep their distinct colors. Section artwork shares walnut outlines, bronze shading, and gold highlights. Links retain accessible names.</p>
        </article>
        <article>
          <h3>CTA icons</h3>
          <div class="pixel-icon-row">
            <a class="social-link" href="https://www.linkedin.com/in/bernardosevero/" target="_blank" rel="noreferrer" aria-label="LinkedIn (opens in a new tab)" title="LinkedIn"><PixelIcon name="linkedin" size={31} /></a>
            <a class="social-link" href="https://github.com/bernardosevero" target="_blank" rel="noreferrer" aria-label="GitHub (opens in a new tab)" title="GitHub"><PixelIcon name="github" size={31} /></a>
            {cvAsset ? <CvDownloadLink /> : <PixelIcon name="download" />}
          </div>
          <p>LinkedIn, GitHub, and CV download share the profile-link styles. Tab to inspect focus; hover and press to inspect interaction states.</p>
          {!cvAsset && <p>The CV action stays hidden until the public PDF is supplied; only its icon is shown here.</p>}
        </article>
        <article class="navigation-specimen" aria-labelledby="navigation-specimen-heading">
          <h3 id="navigation-specimen-heading">Site navigation</h3>
          <p>Production dimensions and selected state. This static specimen does not navigate; actual page menus are links.</p>
          <SiteNavigation pathname={`${base}projects/`} preview />
        </article>
        <article>
          <h3>Project cards</h3>
          <div class="project-card-specimens">
            <ProjectCard title="Portfolio source" summary="A project can expose several verified public destinations." links={[{ label: 'Source repository', url: 'https://github.com/bernardosevero/bernardosevero.dev' }, { label: 'Live site', url: 'https://www.alura.com.br/formacao-full-stack-react-node-js' }]} />
            <ProjectCard title="Repository unavailable" summary="Projects without a verified public repository remain readable without a fabricated link." />
          </div>
          <p>Multi-link and read-only states share the same hierarchy with explicit destinations.</p>
        </article>
        <article>
          <h3>Book tiles</h3>
          <div class="book-tile-specimens">
            <BookTile title="White Nights" coverSrc={`${base}images/books/white-nights-penguin.jpg`} />
            <BookTile title="White Nights" coverSrc={`${base}images/books/white-nights-penguin.jpg`} selected />
          </div>
          <p>Default and selected shelf tiles, using the real production component.</p>
        </article>
        <article>
          <h3>Book ratings</h3>
          <BookRating rating={5} />
          <BookRating rating={4.5} />
          <BookRating rating={0} />
          <BookRating />
          <p>Full, fractional, zero, and unrated values use the production star component with an exact screen-reader label.</p>
        </article>
        <article>
          <h3>Tags and status</h3>
          <ul class="tag-list"><li>React</li><li>Go</li></ul>
          <p><span class="status-badge">Finished</span></p>
          <p>Collection metadata uses the same concise labels across project, post, and reading routes.</p>
        </article>
        <article>
          <h3>Topic filters</h3>
          <p><button class="topic-filter" type="button" data-active="true" aria-pressed="true">All</button> <button class="topic-filter" type="button" aria-pressed="false">Engineering</button></p>
          <p>The active filter uses a gold fill and pressed state; filtering always leaves content readable without JavaScript.</p>
        </article>
      </div>
    </section>
      </div>
    </WoodFrame>

  </main>
</BaseLayout>

<script>
  for (const swatch of document.querySelectorAll<HTMLElement>('[data-token]')) {
    const token = swatch.dataset.token;
    const value = swatch.querySelector<HTMLElement>('[data-token-value]');
    if (token && value) value.textContent = getComputedStyle(document.documentElement).getPropertyValue(token).trim();
  }
</script>

<style>
  .system-page {
    width: min(var(--page-width), calc(100% - 32px));
    margin-inline: auto;
    padding: 48px 0 72px;
  }

  .system-page:focus {
    outline: 0;
  }

  .system-header {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: clamp(12px, 3vw, 28px);
    color: var(--ink);
    text-align: center;
  }
  :global(.system-frame > .frame-surface) { padding: 0; }
  .system-surface {
    border: 2px solid var(--parchment-edge);
    background: var(--surface-parchment);
    box-shadow: inset 0 0 0 4px #f9e5b180, inset 0 0 20px #b5824260, 0 0 0 2px var(--wood-dark);
  }
  .system-header { padding: clamp(20px, 4vw, 36px); margin-bottom: 12px; }
  .system-header h1 { margin: 0; font-size: clamp(42px, 7vw, 72px); line-height: .95; text-transform: uppercase; }
  .system-header :global(.ornament--sprig) { flex: 0 0 38px; }
  .system-body { display: grid; gap: 12px; }
  .system-section { padding: clamp(22px, 4vw, 44px); }
  .system-section > h2 { font-size: clamp(32px, 5vw, 48px); text-align: center; text-transform: uppercase; }
  .system-section > :global(.ornament--divider) { margin: 10px 0 28px; }
  .type-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); gap: 20px; }
  .component-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .component-grid > article > h3 { font-size: 26px; text-transform: uppercase; }
  .component-grid > article > p { margin: 0; font-size: 23px; }
  .swatch-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 14px; }
  .swatch { display: grid; grid-template-columns: 46px 1fr; gap: 2px 12px; align-items: center; min-width: 0; }
  .swatch-color { grid-row: span 2; width: 46px; aspect-ratio: 1; background: var(--swatch); border: 3px solid var(--ink); box-shadow: inset 2px 2px #ffffff55; }
  .swatch code, .swatch small { overflow-wrap: anywhere; }
  .swatch small { color: var(--ink-soft); }
  .type-heading { font: 700 38px/1 var(--font-heading); text-transform: uppercase; }
  .type-body { font: 400 30px/1.15 var(--font-body); }
  .project-card-specimens { display: grid; gap: 12px; }
  .component-grid > article > .rpg-button { width: 100%; }
  .component-grid > article { display: grid; align-content: start; gap: 12px; min-width: 0; padding: 20px; border: 1px solid var(--parchment-edge); }
  .navigation-specimen { color: inherit; }
  .navigation-specimen p { margin: 0; }
  .book-tile-specimens { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; padding: 16px 4px; }
  .system-page { overflow-wrap: anywhere; }
  .system-page :global(.frame-surface) { height: auto; }
  :global(.wood-frame-specimen) { width: 100%; min-height: 94px; }
  :global(.wood-frame-specimen .frame-surface) { display: grid; place-items: center; border: 2px solid var(--wood-dark); background: #321b1088; color: var(--parchment-light); font-family: var(--font-heading); font-size: 19px; text-align: center; text-transform: uppercase; }
  .ornament-row { display: flex; gap: 24px; align-items: center; min-height: 66px; }
  .ornament-row :global(.ornament--divider) { width: min(260px, 70%); margin: 0; }
  .pixel-icon-row { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; min-height: 66px; }
  footer { color: var(--parchment-light); text-align: center; }
  @media (max-width: 760px) { .component-grid { grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); } }
  @media (max-width: 520px) {
    .system-page { padding-top: 28px; width: calc(100% - 16px); }
    .system-section { padding: 22px 12px; }
    .component-grid > article { padding: 12px; }
    .book-tile-specimens { gap: 16px; }
  }
</style>
