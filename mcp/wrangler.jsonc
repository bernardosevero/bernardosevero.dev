{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Not "bernardosevero-dev": an unrelated Worker in the account already has that name.
  "name": "bernardosevero-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "mcp.bernardosevero.dev", "custom_domain": true }],
  "vars": {
    // The only URL the Worker ever fetches (docs/mcp.md, invariant 4).
    "SNAPSHOT_URL": "https://bernardosevero.dev/api/v1/content.json",
    // Public PostHog values, supplied at deploy time. Analytics stay off while empty.
    "POSTHOG_KEY": "",
    "POSTHOG_HOST": "",
  },
  // Approximate, and counted per Cloudflare location.
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "4701", "simple": { "limit": 60, "period": 60 } },
  ],
  "observability": { "enabled": true },
}
